# =======================================================================
# Digisharks Communications — environment variables
#
# Copy this file to `.env.local` for development and set the values that
# apply to your environment. In production (Vercel), set the same keys
# in the project's Environment Variables settings.
# =======================================================================

# ---------- Database ----------
# Local dev: leave the default. Prod: paste your MongoDB Atlas connection
# string here or in Vercel project settings.
MONGODB_URI=mongodb://localhost:27017/digisharks

# ---------- Admin auth ----------
# First login will hash the password and store it in the `admins`
# collection automatically (see src/lib/admin-seed.ts).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
# Existing JWT secret — used by both contact-queries admin and the
# digital-products admin. Generate a long random string in production.
JWT_SECRET=please-change-this-secret-in-production

# ---------- Razorpay (digital products) ----------
# Get keys at https://dashboard.razorpay.com/app/keys
#
# Live (rzp_live_*) vs Test (rzp_test_*) is auto-detected from the
# key prefix — the storefront works in both modes.
#
# Live keys are configured in `.env.local` for production use.
# Leave BOTH empty here to fall back to sandbox/demo mode
# (no real charges, useful for local UI development).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------- Digital product assets ----------
# Public URL the buyer receives in the confirmation email
# (the actual PDF / database file).
DATABASE_DOWNLOAD_URL=
# "How to use" demo video link included in the email and on the
# order-success page.
HOW_TO_USE_VIDEO_URL=
# Optional absolute path on the server to attach the file to the
# confirmation email. Leave blank to send a download link only.
DATABASE_FILE_PATH=

# ---------- Email (delivery + contact) ----------
# MAIL_FROM_EMAIL is used as the From: address.
MAIL_FROM_NAME=Digisharks Communications
MAIL_FROM_EMAIL=noreply@digisharkscommunications.com
# ADMIN_EMAIL is BCC'd on every digital-product order so the team
# can see new sales in their inbox.
ADMIN_EMAIL=

# Pick ONE of the following transports — the mailer picks whichever is
# fully configured. Leave them all blank to run in console-fallback mode
# (emails are logged to the dev-server terminal).

# -- SMTP (e.g. Zoho, SendGrid, Hostinger, cPanel) --
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# -- Resend (recommended) --
RESEND_API_KEY=
