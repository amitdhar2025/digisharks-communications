# =============================================================================
# Digisharks Communications — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
#   cp .env.example .env.local
#
# REQUIRED variables will crash the app if missing.
# OPTIONAL variables have safe fallbacks.
# SECRET variables (marked 🔒) should never be exposed to the browser.
# =============================================================================

# ── Site URL ─────────────────────────────────────────────────────────────────
# Public: Used for canonical URLs, sitemap, robots.txt, email links,
# breadcrumbs, and Open Graph / Twitter card metadata.
NEXT_PUBLIC_SITE_URL=https://www.digisharkscommunications.com

# ── MongoDB Atlas (🔒 Secret) ────────────────────────────────────────────────
# Required for ALL database operations (admin login, products, orders, blog,
# chatbot, CMS, SEO audits, backups, etc.)
# Get from: MongoDB Atlas -> Cluster -> Connect -> Connect your application
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ── Admin Authentication (🔒 Secret) ─────────────────────────────────────────
# JWT secret for admin panel session tokens. Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here

# Session secret for CMS admin panel encryption
ADMIN_SESSION_SECRET=your-admin-session-secret-here

# Default admin credentials (used for first login / password reset)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password
CMS_ADMIN_USERNAME=cmsadmin
CMS_ADMIN_PASSWORD=your-cms-admin-password

# Admin notification email (receives new job application alerts, etc.)
ADMIN_EMAIL=marketing@digisharkscommunications.com
CMS_ADMIN_EMAIL=marketing@digisharkscommunications.com

# ── Cloudinary (🔒 Secret) ───────────────────────────────────────────────────
# Required for image/video uploads in admin blog, CMS, career applications,
# and Cloudinary-based media backup.
# Get from: Cloudinary Dashboard -> Account Details
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Razorpay (🔒 Secret) ─────────────────────────────────────────────────────
# Required for accepting payments via the checkout flow.
# Get from: Razorpay Dashboard -> Settings -> API Keys
# Use TEST keys for development, LIVE keys for production.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ── Email / SMTP (🔒 Secret) ─────────────────────────────────────────────────
# Required for sending contact form confirmations, order receipts,
# SEO audit reports, career application status updates, and password resets.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=marketing@digisharkscommunications.com
SMTP_PASS=your-smtp-password-or-app-password
MAIL_FROM_NAME=Digisharks Communications
MAIL_FROM_EMAIL=noreply@digisharkscommunications.com

# ── Backblaze B2 (🔒 Secret) ─────────────────────────────────────────────────
# Required for automated daily backups (database + Cloudinary media).
# Get from: Backblaze B2 Dashboard -> App Keys
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=digisharks-backups

# ── GitHub (🔒 Secret) ───────────────────────────────────────────────────────
# Required for:
#   - Triggering backup workflow via admin dashboard
#   - Syncing CMS content to GitHub (exports MongoDB -> JSON files -> commits)
# GitHub Personal Access Token with 'repo' and 'workflow' scopes.
# Get from: GitHub -> Settings -> Developer settings -> Personal access tokens
GH_PAT=your-github-personal-access-token
# Override repo name (falls back to VERCEL_GIT_REPO_OWNER/VERCEL_GIT_REPO_SLUG)
GH_REPO=digisharks/digisharks-communications

# ── Optional Add-ons ─────────────────────────────────────────────────────────

# Serper.dev API Key - enables Google Search via chatbot
# Get from: https://serper.dev
SERPER_API_KEY=your-serper-api-key

# Google API Key - enables PageSpeed Insights in SEO audit reports
# Get from: Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_API_KEY=your-google-api-key

# Product download overrides (for development/testing)
DATABASE_DOWNLOAD_URL=https://example.com/sample-database.pdf
HOW_TO_USE_VIDEO_URL=https://www.youtube.com/watch?v=example
DATABASE_FILE_PATH=data/sample-database.pdf

# =============================================================================
# Quick Setup Guide
# =============================================================================
# For Vercel Deployment:
#   - Set ALL of the above in Vercel -> Project Settings -> Environment Variables
#   - NEXT_PUBLIC_* variables are exposed to the browser - only put safe values
#   - Set NEXT_PUBLIC_SITE_URL to different values for Production vs Preview
#
# For GitHub Actions:
#   - Required secrets: MONGODB_URI, CLOUDINARY_*, B2_*, GH_PAT
#   - Set at: GitHub -> Repo -> Settings -> Secrets and variables -> Actions
#
# For Local Development:
#   1. cp .env.example .env.local
#   2. Fill in your values
#   3. npm install
#   4. npm run dev
#   5. Open http://localhost:3000
# =============================================================================
