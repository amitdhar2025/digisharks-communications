# ── Correct MIME types for modern image formats ──
AddType image/avif .avif
AddType image/webp .webp
AddType image/svg+xml .svg

# ── Correct MIME types for fonts ──
AddType font/woff2 .woff2
AddType font/woff .woff

# ── Correct MIME types for text assets ──
AddType text/css .css
AddType application/javascript .js .mjs

# ── Security: prevent MIME sniffing ──
Header always set X-Content-Type-Options "nosniff"

# ── Aggressive caching for content-hashed static assets (1 year, immutable) ──
<FilesMatch "(?i)\.(avif|webp|jpg|jpeg|png|gif|svg|ico|woff2|woff|ttf|eot)$">
  Header always set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# ── JS/JSX chunks — no-cache (must-revalidate to prevent stale bundles) ──
<FilesMatch "(?i)\.(js)$">
  Header always set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>

# ── CSS caching (1 year, immutable — content-hashed by Next.js) ──
<FilesMatch "(?i)\.(css)$">
  Header always set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

