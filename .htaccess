# ── Correct MIME types for modern image formats ──
AddType image/avif .avif
AddType image/webp .webp
AddType image/svg+xml .svg

# ── Correct MIME types for fonts ──
AddType font/woff2 .woff2
AddType font/woff .woff

# ── Security: prevent MIME sniffing ──
Header always set X-Content-Type-Options "nosniff"

# ── Aggressive caching for content-hashed static assets (1 year, immutable) ──
<FilesMatch "(?i)\.(avif|webp|jpg|jpeg|png|gif|svg|ico|woff2|woff|ttf|eot)$">
  Header always set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# ── CSS/JS caching (1 year, immutable — content-hashed by Next.js) ──
<FilesMatch "(?i)\.(css|js)$">
  Header always set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
